<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="C#">
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Graphics\Decoding\Fixtures\*">
      <LogicalName>kajarlabs.Framework.Tests.Graphics.Decoding.Fixtures.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IO\Resources\Fixtures\UI\button.hover.txt" />
    <EmbeddedResource Include="IO\Resources\Fixtures\hero-upper.txt">
      <LogicalName>kajarlabs.Framework.Tests.IO.Resources.Fixtures.Collision.Hero.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IO\Resources\Fixtures\hero-lower.txt">
      <LogicalName>kajarlabs.Framework.Tests.IO.Resources.Fixtures.Collision.hero.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IO\Resources\Fixtures\slash-asset.txt">
      <LogicalName>CustomLogical/nested/slash-asset.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IO\Resources\Fixtures\override-target.txt">
      <LogicalName>kajarlabs.Framework.Tests.IO.Resources.Fixtures.Textures.hero.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\framework\kajarlabs.Framework.csproj" />
    <ProjectReference Update="..\..\libs\code-analysis\kajarlabs.Framework.CodeAnalysis.csproj"
                      OutputItemType=""
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
  <Target Name="AddGeneratorAsAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="@(ReferencePath)" Condition="'%(Filename)' == 'kajarlabs.Framework.CodeAnalysis'" />
    </ItemGroup>
  </Target>
</Project>