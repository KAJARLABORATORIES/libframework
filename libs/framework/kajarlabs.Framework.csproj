<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A lean, extensible game framework for .NET.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="kajarlabs.Framework.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Shaders\Compiled\*">
      <LogicalName>kajarlabs.Framework.Resources.Shaders.Compiled.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
  </ItemGroup>
</Project>