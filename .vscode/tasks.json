{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build (Release)",
      "type": "shell",
      "command": "dotnet build -c Release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test (Release)",
      "type": "shell",
      "command": "dotnet test -c Release",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: format verify",
      "type": "shell",
      "command": "dotnet format --verify-no-changes",
      "problemMatcher": []
    },
    {
      "label": "ci: local pre-PR check",
      "type": "shell",
      "windows": {
        "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1"
      },
      "linux": {
        "command": "bash scripts/check.sh"
      },
      "osx": {
        "command": "bash scripts/check.sh"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
