<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A lean, extensible game framework for .NET.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="kajarlabs.Framework.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Shaders\Compiled\*">
      <LogicalName>kajarlabs.Framework.Resources.Shaders.Compiled.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\code-analysis\kajarlabs.Framework.CodeAnalysis.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\code-analysis\bin\$(Configuration)\netstandard2.0\kajarlabs.Framework.CodeAnalysis.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
    <PackageReference Include="StbImageNext" />
  </ItemGroup>
</Project>