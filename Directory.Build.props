<Project>
  <PropertyGroup Label="C#">
    <TargetFramework>net11.0</TargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <Authors>KAJAR LABORATORIES</Authors>
    <Company>KAJAR LABORATORIES</Company>
    <Copyright>Copyright (c) 2026 KAJAR LABORATORIES</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KAJARLABORATORIES/libframework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KAJARLABORATORIES/libframework</RepositoryUrl>
  </PropertyGroup>
</Project>